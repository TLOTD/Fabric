{
  "schemaVersion": 1,
	"id": "tlotd",
	"version": "${version}",
	"name": "TLOTD",
	"description": "The Better Than Adventure Babric Port - This Mod adds new Dimensions and progression after the normal Diamond tier. Additionally this mod provides feats in Engineering and Technology!",
	"authors": [
		"TLOTD",
		"Isla_Nublar"
	],
	"contact": {
		"homepage": "https://tlotd.net/",
		"sources": "https://github.com/tlotd/Fabric"
	},
	"license": "CC-BY-NC-SA-4.0",
	"icon": "assets/tlotd/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
			"net.tlotd.TLOTD"
    ],
		"beforeGameStart": [
			"net.tlotd.TLOTD"
		],
		"afterGameStart": [
			"net.tlotd.TLOTD"
		],
		"recipesReady": [
			"net.tlotd.TLOTD"
		],
		"recipesReady": [
			"net.tlotd.datagen.ModRecipeProvider"
		],
		"initModels": [
			"net.tlotd.datagen.ModModelProvider"
		]
	},
  "mixins": [
    "tlotd.mixins.json"
  ],

  "depends": {
		"minecraft": "*",
    "fabricloader": ">=0.15.5"
  },
  "suggests": {
  }
}
